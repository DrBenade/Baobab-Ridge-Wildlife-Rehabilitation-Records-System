// Find the animal in the active list
Animal animalToDelete = animals.FirstOrDefault(a =>
    a.AnimalId.Equals(
        animalId,
        StringComparison.OrdinalIgnoreCase));

// Remove only this animal if found
if (animalToDelete != null)
{
    animals.Remove(animalToDelete);

    // Rewrite animals.txt with the updated list
    bool success =
        fileHandler.RewriteAllAnimals(animals);

    if (success)
    {
        // Refresh the grid to show the deletion
        RefreshGrid();

        // If this animal was loaded into the textboxes,
        // clear the inputs and exit edit mode
        if (txtAnimalId.Text.Equals(
            animalId,
            StringComparison.OrdinalIgnoreCase))
        {
            ClearInputs();
            SetEditMode(false);
        }

        MessageBox.Show(
            "Animal deleted successfully.",
            "Deleted",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information);
    }
}
