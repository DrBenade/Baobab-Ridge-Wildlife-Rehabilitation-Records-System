private void btnDelete_Click(object sender, EventArgs e)
{
    // Feature 4.1 - Check if a row is selected
    if (dgvAnimals.SelectedRows.Count == 0)
    {
        MessageBox.Show(
            "Please select an animal to delete.",
            "No Selection",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning);

        return;
    }

    // Feature 4.2 - Get Animal ID and Name
    DataGridViewRow selectedRow =
        dgvAnimals.SelectedRows[0];

    string animalId =
        selectedRow.Cells[0].Value.ToString();

    string animalName =
        selectedRow.Cells[1].Value.ToString();

    // Show confirmation dialog
    DialogResult result = MessageBox.Show(
        $"Delete {animalId} ({animalName})? This cannot be undone.",
        "Confirm Delete",
        MessageBoxButtons.YesNo,
        MessageBoxIcon.Warning);

    // If user selects No, stop
    if (result == DialogResult.No)
    {
        return;
    }

